# Google Places API — deja ambas vacías para servir reseñas de muestra.
# Una vez que tengas credenciales reales, /api/reviews cambiará
# automáticamente a datos en vivo de Google (ver src/app/api/reviews/route.ts).
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Acceso de administrador (demo). Genera ADMIN_SESSION_TOKEN con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Limitación conocida: una sola credencial compartida, sin hash, sin
# rate limiting. No usar tal cual en producción real.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_TOKEN=

# Supabase — catálogo de productos y almacenamiento de imágenes.
# Ver panel de Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nunca exponer al navegador: solo se usa en Route Handlers server-side.
SUPABASE_SERVICE_ROLE_KEY=
