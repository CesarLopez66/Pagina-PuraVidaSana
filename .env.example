# Google Places API. Si quedan vacías, el inicio no muestra reseñas.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Acceso de administrador. Genera ADMIN_SESSION_TOKEN con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_TOKEN=

# Supabase — catálogo de productos y almacenamiento de imágenes.
# Ver panel de Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nunca exponer al navegador: solo se usa en Route Handlers server-side.
SUPABASE_SERVICE_ROLE_KEY=
